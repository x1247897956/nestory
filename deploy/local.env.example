# Copy to the project root as .env for this existing local deployment.
# Use the image ID reported by docker inspect to pin the exact deployed image.
COMPOSE_PROJECT_NAME=noteapp-v1-check
APP_BIND=127.0.0.1
APP_PORT=18084
APP_VOLUME_NAME=noteapp-v1-check
APP_IMAGE=noteapp:local
APP_VERSION=development
# Generated from the host system: python3 scripts/local_deploy.py configure
APP_ALLOWED_HOSTS=localhost,127.0.0.1,::1
APP_UPLOAD_LIMIT=20971520
