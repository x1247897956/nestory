# Default deny: only files needed to compile the application enter the context.
**
!go.mod
!go.sum
!cmd/
!cmd/**
!internal/
!internal/**
!migrations/
!migrations/**

# Apply these exclusions even inside the allowed source directories.
**/*_test.go
**/*.test.*
**/*.spec.*
**/testdata/
**/__tests__/
web/src/test/
web/src/test-setup.ts
**/.env
**/.env.*
**/.git/
**/.aws/
**/.ssh/
**/.codex/
**/.agents/
**/*.key
**/*.pem
**/*.p12
**/*.pfx
**/*.py
**/*.pyc
**/*.pyo
**/__pycache__/
