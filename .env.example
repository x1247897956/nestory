APP_BIND=127.0.0.1
# 已有部署请保留自己的 .env、项目名、镜像和数据卷，不要用模板覆盖。
# COMPOSE_PROJECT_NAME 可固定部署项目名；默认按当前目录命名。
APP_PORT=8080
# 显式设置 IANA 时区，例如 Asia/Shanghai、Europe/Berlin 或 UTC。
APP_TIMEZONE=Asia/Shanghai
# 本地 Go 开发可设置 APP_ADDR=127.0.0.1:8080 APP_DATA_DIR=./data
# 经 Vite 代理开发时，显式允许浏览器来源：
# APP_DEV_ORIGIN=http://127.0.0.1:5173

# 单附件最大字节数，默认20 MiB
APP_UPLOAD_LIMIT=20971520

# 可复现升级/回滚与明确命名卷；修改卷名会切换数据集
APP_IMAGE=noteapp:local
APP_FRONTEND_IMAGE=noteapp-web:local
# 构建时写入程序与镜像标签；仅重启已有镜像不会改变其版本。
APP_VERSION=development
# 可分别指定前端版本；未设置时沿用 APP_VERSION。
# APP_FRONTEND_VERSION=development
APP_VOLUME_NAME=noteapp_noteapp-data

# 允许的精确主机名/IP，不含端口、通配符或 URL。DNS 名忽略大小写和一个尾随点。
# 所有路由均检查 Host；请求可带有效端口。LAN 访问须显式追加主机/IP。
APP_ALLOWED_HOSTS=localhost,127.0.0.1,::1
